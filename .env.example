# Public developer MCP works without credentials.
HOST=127.0.0.1
PORT=3333

# App management: one app per server instance. Required for `app` mode.
# CONVOKIT_CLIENT_ID=your-public-app-id
# CONVOKIT_CLIENT_SECRET=your-server-only-app-secret

# Required to enable /mcp/app over HTTP. Use a separate random token, at least 32 chars.
# CONVOKIT_MCP_APP_TOKEN=replace-with-a-random-token

# Optional endpoint override for local testing or self-hosting.
# CONVOKIT_API_URL=http://127.0.0.1:3000

# Required when HOST is not a loopback address. Values are hostnames, not URLs.
# CONVOKIT_MCP_ALLOWED_HOSTS=mcp.example.com
# Optional browser origins. Comma-separated origins including protocol and port.
# CONVOKIT_MCP_ALLOWED_ORIGINS=https://your-client.example.com
